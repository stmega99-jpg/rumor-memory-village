# Runtime region and the name/ARN of the AWS Secrets Manager secret.
AWS_REGION=us-east-1
RMV_SECRET_ID=rumor-memory-village/prod

# Deployment-only switch for the one-time live Bedrock smoke test. Leave false
# for the public demo so the pre-generated database line is reused.
RMV_LIVE_BEDROCK_PROBE=false
RMV_BEDROCK_REGION=ap-northeast-1

# Local-only escape hatch. Production must leave this unset/false and use the
# Amplify SSR Compute Role plus AWS Secrets Manager, where the same three values
# live in the secret named by RMV_SECRET_ID as cockroachSqlUrl,
# cockroachMcpApiKey and cockroachClusterId.
RMV_ALLOW_ENV_SECRETS=false

# CockroachDB Cloud > cluster > Connect. The database in the path is rewritten
# to rumor_memory_village at connection time, so the string the console hands
# out can be pasted unedited.
RMV_COCKROACH_SQL_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full

# CockroachDB Cloud > Service Accounts > Create API key. Shown once.
RMV_COCKROACH_MCP_API_KEY=replace-with-a-local-development-key

RMV_COCKROACH_CLUSTER_ID=dcd3153f-e8af-4509-a796-b4f160170270
